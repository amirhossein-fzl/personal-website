{
  "mcpServers": {
    "nuxt": {
      "type": "http",
      "url": "http://localhost:3000"
    },
    "playwright": {
      "command": "pnpx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ]
    },
    "devtools": {
      "command": "pnpx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--slim",
        "--headless"
      ]
    }
  }
}
