{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nuxt": {
      "type": "remote",
      "url": "http://localhost:3000/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "pnpx",
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "environment": {},
      "enabled": true
    },
    "devtools": {
      "type": "local",
      "command": [
        "pnpx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--slim",
        "--headless"
      ],
      "environment": {},
      "enabled": true
    }
  }
}